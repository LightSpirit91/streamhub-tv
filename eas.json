{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "tv-dev": {
      "developmentClient": false,
      "distribution": "internal",
      "env": {
        "EXPO_TV": "1"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "tv": {
      "distribution": "internal",
      "env": {
        "EXPO_TV": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "phone": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "ios": {
      "distribution": "store",
      "ios": {
        "autoIncrement": true
      }
    },
    "ios-sim": {
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "ios": {}
  }
}